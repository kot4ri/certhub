      payload=$(printf '{"command_token":"%s","system":%s}' "${update_info[0]}" "$sysinfo")
      curl_with_ipv4_fallback --fail --silent --show-error --proto '=https' --tlsv1.2 "${auth[@]}" --data-binary "$payload" "$api?action=ack_update" >/dev/null
    else
      update_file=$(mktemp /usr/local/sbin/.certhub-agent-update.XXXXXX)
      curl_with_ipv4_fallback --fail --silent --show-error --proto '=https' --tlsv1.2 "${update_info[3]}" -o "$update_file"
      python3 - "$update_file" "${update_info[2]}" <<'PY'
