PY
      payload=$(printf '{"command_token":"%s","system":%s}' "${update_info[0]}" "$sysinfo")
      curl_with_ipv4_fallback --fail --silent --show-error --proto '=https' --tlsv1.2 "${auth[@]}" --data-binary "$payload" "$api?action=ack_update" >/dev/null
      systemctl restart certhub-agent.service >/dev/null 2>&1 &
      exit 0
    fi
  fi
