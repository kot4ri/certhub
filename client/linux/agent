)
  for cert_job in "${cert_jobs[@]}";do
    [[ -n $cert_job ]] || continue
    local cert_id expected_version
    read -r cert_id expected_version <<< "$cert_job"
    local work
    work=$(mktemp -d "$STATE/.stage.XXXXXX")
    printf '{"certificate_id":%s,"system":%s}' "$cert_id" "$sysinfo" > "$work/request.json"
    curl_with_ipv4_fallback --fail --silent --show-error --proto '=https' --tlsv1.2 "${auth[@]}" --data-binary "@$work/request.json" "$api?action=bundle" -o "$work/bundle.json"
    python3 - "$work" "$STATE" "$STATE/server-config.json" <<'PY'
