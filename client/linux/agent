)
  printf '%s\n' "$now" > "$STATE/last-schedule-check"
  if [[ $due != 1 ]]; then rm -f "$response";return 0;fi
  mapfile -t cert_jobs < <(python3 - "$response" "$STATE/certificate-versions.json" "$force" "$command_token" "$deployment_changed" <<'PY'
