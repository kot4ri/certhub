 info={'issuer':'CertHub','issuer_O':'CertHub','notAfter':time.strftime('%Y-%m-%d',time.gmtime(ssl.cert_time_to_seconds(decoded['notAfter']))),'notBefore':decoded.get('notBefore'),'dns':sans,'subject':cn,'endtime':int((ssl.cert_time_to_seconds(decoded['notAfter'])-time.time())/86400)}
 open(legacy+'/info.json','w').write(json.dumps(info,separators=(',',':')));os.chmod(legacy+'/info.json',0o644)
