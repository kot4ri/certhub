#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
CONFIG=/etc/certhub-agent/config.json
STATE=/var/lib/certhub-agent
POLL_SECONDS=300

cfg(){ python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))[sys.argv[2]])' "$CONFIG" "$1"; }
system_json(){ python3 - <<'PY'
import json,platform
i={'hostname':platform.node(),'os_name':platform.system(),'os_version':platform.platform(),'architecture':platform.machine(),'agent_version':'0.3.12'}
try:
 for line in open('/etc/os-release'):
  if line.startswith('PRETTY_NAME='):i['os_version']=line.split('=',1)[1].strip().strip('"');break
except OSError:pass
print(json.dumps(i,separators=(',',':')))
PY
}

curl_with_ipv4_fallback(){
  curl "$@" || {
    echo 'IPv6/默认网络请求失败，正在回落到 IPv4 重试。' >&2
    curl -4 "$@"
  }
}

