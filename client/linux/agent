    curl_with_ipv4_fallback --fail --silent --show-error --proto '=https' --tlsv1.2 "${auth[@]}" --data-binary "$payload" "$api?action=ack_cleanup" >/dev/null
    rm -f "$response";return 0
  fi
  python3 - "$response" "$STATE/server-config.json" "$STATE/deployment-state.json" "$STATE/certificate-versions.json" "$STATE/certificates" <<'PY'
